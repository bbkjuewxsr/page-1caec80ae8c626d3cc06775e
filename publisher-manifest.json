          "body": "<style>\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n:root{--wine:#6e2230;--wine-deep:#4a1820;--wine-soft:#8a3543;--ivory:#f6efe3;--ivory-warm:#efe6d2;--ink:#241a1c;--ink-soft:#5b4a4d;--line:#c9b89c;--dash:#8a3543}\nhtml{font-size:16px}\nbody{background:var(--ivory);color:var(--ink);font-family:\"PingFang SC\",\"Microsoft YaHei\",\"Hiragino Sans GB\",sans-serif;line-height:1.7;-webkit-font-smoothing:antialiased;padding:1.25rem}\nmain{max-width:1180px;margin:0 auto;background:var(--ivory)}\nsection{padding:3.5rem 0;border-bottom:1px dashed var(--line)}\nsection:last-child{border-bottom:none}\nh1,h2,h3{font-weight:600;letter-spacing:0.02em;color:var(--wine-deep)}\nh1{font-size:clamp(2.2rem,5vw,3.6rem);line-height:1.15;margin-bottom:1rem}\nh2{font-size:clamp(1.5rem,3vw,2.1rem);margin-bottom:1.5rem;padding-bottom:.6rem;border-bottom:2px solid var(--wine);display:inline-block}\nh3{font-size:1.15rem;margin-bottom:.6rem;color:var(--wine)}\np,li{font-size:1rem;color:var(--ink)}\n.lede{font-size:1.1rem;color:var(--ink-soft);max-width:60ch;margin-bottom:2rem}\n.anchor-row{display:flex;flex-wrap:wrap;gap:.6rem 1rem;padding:1rem 1.2rem;border:1px dashed var(--dash);background:var(--ivory-warm);margin-bottom:2.5rem}\n.anchor-row a{color:var(--wine-deep);text-decoration:none;font-size:.92rem;padding:.2rem .6rem;border:1px dashed var(--wine)}\n.anchor-row a:hover{background:var(--wine);color:var(--ivory)}\n\n.dash{border:1.5px dashed var(--dash);background:#fbf6ec;padding:1.5rem;margin-bottom:1rem}\n.dash.tight{padding:1rem}\n.dash.accent{border-color:var(--wine);background:#f1e3d3}\n\n.hero-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1rem;margin-top:1.5rem}\n.tile{border:1.5px dashed var(--dash);background:#fbf6ec;padding:1.2rem;min-height:120px;display:flex;flex-direction:column;justify-content:space-between}\n.tile .label{font-size:.78rem;letter-spacing:.15em;color:var(--wine);text-transform:uppercase}\n.tile .value{font-siz